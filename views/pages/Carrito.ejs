     <div class="cart-container">
      <h2>Carrito de Compras</h2>
      <ul id="cart-items">
        <!-- Cart items will be dynamically added here -->
      </ul>
      <div class="cart-total">
        <span class="label">Total:</span>
        <span id="cart-total-value">0.00</span>
      </div>
      <button id="checkout-button">Finalizar Compra</button>
    </div>


    
    <script>
      document.addEventListener('DOMContentLoaded', function() {
  let cart = [];
  let cartTotal = 0;

  // Function to add item to cart
  function addItemToCart(item) {
    cart.push(item);
    cartTotal += item.price;
    updateCartDisplay();
  }

  // Function to update the cart display
  function updateCartDisplay() {
    const cartItemsElement = document.getElementById('cart-items');
    const cartTotalValueElement = document.getElementById('cart-total-value');

    cartItemsElement.innerHTML = ''; // Clear existing items

    cart.forEach(item => {
      const li = document.createElement('li');
      li.textContent = `${item.name} - Precio: ${item.price.toFixed(2)}`; // Format price
      cartItemsElement.appendChild(li);
    });

    cartTotalValueElement.textContent = cartTotal.toFixed(2); // Format total
  }

  // Get all "add" buttons (you're using a button-floating)
  const addButtons = document.querySelectorAll('.btn-floating'); // Correct selector

  addButtons.forEach(button => {
    button.addEventListener('click', () => {
      // Assuming each button is associated with a specific product
      const productName = button.getAttribute('data-product-name'); // Get product name from data attribute
      const productPrice = parseFloat(button.getAttribute('data-product-price')); // Get product price from data attribute

      // Create product object
      const product = {
        name: productName,
        price: productPrice
      };

      addItemToCart(product);
    });
  });

  // Checkout button functionality
  document.getElementById('checkout-button').addEventListener('click', () => {
    // Generate receipt
    const receipt = generateReceipt();

    // Display receipt (you can modify this part to display in a new window, print directly, etc.)
    alert(receipt);
  });

  // Function to generate receipt
  function generateReceipt() {
    const now = new Date();
    const dateString = now.toLocaleDateString('es-ES');  // Spanish date format
    const timeString = now.toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' }); // Spanish time format

    let receipt = `
      **Recibo de Compra**\n
      Fecha: ${dateString}\n
      Hora: ${timeString}\n\n`;

    cart.forEach(item => {
      receipt += `Producto: ${item.name} - Precio: ${item.price.toFixed(2)}\n`;
    });

    receipt += `\nTotal: ${cartTotal.toFixed(2)}`;

    return receipt;
  }
});
    </script>








































