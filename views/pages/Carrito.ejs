<!DOCTYPE html>
<html>
  <%- include('../partials/head') %>
<body>
  <%- include('../partials/header') %>

  <div class="card">
  <div class="card-content">
    <span class="card-title">Productos Seleccionados</span>

    <table class="striped responsive-table">
      <thead class="green accent-4">
        <tr>
          <th>Producto</th>
          <th>Precio Unitario</th>
          <th>Cantidad</th>
          <th>Total</th>
          <th>Acción</th>
        </tr>
      </thead>
      <tbody>
        <!--
          Repite este <tr> por cada ítem del carrito,
          o bien úsalo como plantilla si vas a renderizar dinámicamente
        -->
        <tr>
          <td>Nombre del Producto</td>
          <td>$10.000</td>
          <td>2</td>
          <td>$20.000</td>
          <td>
            <a class="btn-small green accent-4 white-text" href="#eliminar">
              Eliminar
            </a>
          </td>
        </tr>
      </tbody>
    </table>

    <div class="right-align" style="margin-top: 20px;">
      <h6>
        <strong>Total a pagar:</strong>
        <span class="pink-text text-lighten-2">$20.000</span>
      </h6>
      <a href="/vistametodopago" class="btn green accent-4 white-text" href="#finalizar-compra">
        Finalizar Compra
        <i class="material-icons right">payment</i>
      </a>
    </div>
  </div>
</div>


  <%- include('../partials/footer') %>

  <!-- Scripts -->
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      let cart = [];
      let cartTotal = 0;

      function addItemToCart(item) {
        cart.push(item);
        cartTotal += item.price;
        updateCartDisplay();
      }

      function updateCartDisplay() {
        const cartItemsElement = document.getElementById('cart-items');
        const cartTotalValueElement = document.getElementById('cart-total-value');
        cartItemsElement.innerHTML = '';
        cart.forEach(item => {
          const li = document.createElement('li');
          li.className = 'collection-item';
          li.textContent = `${item.name} - $${item.price.toFixed(2)}`;
          cartItemsElement.appendChild(li);
        });
        cartTotalValueElement.textContent = cartTotal.toFixed(2);
      }

      document.querySelectorAll('.btn-floating').forEach(button => {
        button.addEventListener('click', () => {
          const productName = button.dataset.productName;
          const productPrice = parseFloat(button.dataset.productPrice);
          addItemToCart({ name: productName, price: productPrice });
          M.toast({ html: '¡Añadido al carrito!' });
        });
      });

      document.getElementById('checkout-button').addEventListener('click', () => {
        alert(generateReceipt());
      });

      function generateReceipt() {
        const now = new Date();
        const dateString = now.toLocaleDateString('es-ES');
        const timeString = now.toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' });
        let receipt = `**Recibo de Compra**\nFecha: ${dateString}\nHora: ${timeString}\n\n`;
        cart.forEach(item => {
          receipt += `Producto: ${item.name} - $${item.price.toFixed(2)}\n`;
        });
        receipt += `\nTotal: $${cartTotal.toFixed(2)}`;
        return receipt;
      }
    });
  </script>
</body>
</html>
