<!DOCTYPE html>
<html>
  <%- include('../partials/head') %>
<body>
  <%- include('../partials/header') %>

  <div class="container" style="margin-top: 2rem;">
    <div class="card">
      <div class="card-content">
        <span class="card-title">Productos Seleccionados</span>

        <ul id="cart-items" class="collection">
          <!-- Se rellenará dinámicamente -->
        </ul>

        <div class="right-align" style="margin-top: 20px;">
          <h6>
            <strong>Total a pagar: </strong>
            <span id="cart-total-value" class="pink-text text-lighten-2">$0.00</span>
          </h6>
          <a id="checkout-button" href="/vistametodopago" class="btn green accent-4 white-text">
            Finalizar Compra
            <i class="material-icons right">payment</i>
          </a>
        </div>
      </div>
    </div>
  </div>

  <%- include('../partials/footer') %>

  <!-- Scripts -->
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Recupera carrito de localStorage o inicializa vacío
      let cart = JSON.parse(localStorage.getItem('cart')) || [];
      let cartTotal = cart.reduce((sum, item) => sum + item.price, 0);

      const cartItemsElement      = document.getElementById('cart-items');
      const cartTotalValueElement = document.getElementById('cart-total-value');
      const checkoutButton        = document.getElementById('checkout-button');

      function updateCartDisplay() {
        cartItemsElement.innerHTML = '';
        if (cart.length === 0) {
          const li = document.createElement('li');
          li.className = 'collection-item center-align';
          li.textContent = 'Tu carrito está vacío';
          cartItemsElement.appendChild(li);
        } else {
          cart.forEach((item, index) => {
            const li = document.createElement('li');
            li.className = 'collection-item';
            li.innerHTML = `
              ${item.name} - $${item.price.toFixed(2)}
              <a href="#!" class="secondary-content btn-flat remove-item" data-index="${index}">
                <i class="material-icons red-text">delete</i>
              </a>
            `;
            cartItemsElement.appendChild(li);
          });
        }
        cartTotalValueElement.textContent = `$${cartTotal.toFixed(2)}`;
      }

      function saveCart() {
        localStorage.setItem('cart', JSON.stringify(cart));
      }

      // Eliminar un ítem
      cartItemsElement.addEventListener('click', function(e) {
        if (e.target.closest('.remove-item')) {
          const idx = parseInt(e.target.closest('.remove-item').dataset.index, 10);
          cartTotal -= cart[idx].price;
          cart.splice(idx, 1);
          saveCart();
          updateCartDisplay();
        }
      });

      // Finalizar compra
      checkoutButton.addEventListener('click', () => {
        if (cart.length === 0) {
          M.toast({ html: 'Tu carrito está vacío' });
          return;
        }
        const now = new Date();
        const dateString = now.toLocaleDateString('es-ES');
        const timeString = now.toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' });
        let receipt = `Recibo de Compra\nFecha: ${dateString}\nHora: ${timeString}\n\n`;
        cart.forEach(item => {
          receipt += `Producto: ${item.name} - $${item.price.toFixed(2)}\n`;
        });
        receipt += `\nTotal: $${cartTotal.toFixed(2)}`;
        alert(receipt);
        // Limpia carrito
        cart = [];
        cartTotal = 0;
        saveCart();
        updateCartDisplay();
      });

      // Inicializa la vista
      updateCartDisplay();
    });
  </script>
</body>
</html>
