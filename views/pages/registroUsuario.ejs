<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<body>
    <%- include('../partials/header') %>
    <div class="container" style="max-width: 430px; margin-top: 50px;">
  <div class="card z-depth-2 green lighten-5">
    <div class="card-content">
      <span class="card-title center-align green-text text-darken-2" style="font-weight:600;">Registro de Usuario</span>
      <form action="/register" method="POST">
        <div class="input-field">
          <input type="text" id="usuario" name="usuario" class="validate" required>
          <label for="usuario">Nombre de usuario</label>
        </div>
        <div class="input-field">
          <input type="email" id="correo" name="correo" class="validate" required>
          <label for="correo">Correo electrónico</label>
        </div>
        <div class="input-field">
          <input type="password" id="password" name="password" class="validate" required>
          <label for="password">Contraseña</label>
        </div>
        <div class="center-align" style="margin-top: 30px;">
          <button type="submit" class="btn green darken-1 waves-effect waves-light" style="width:100%;">Registrarse</button>
        </div>
      </form>
      <div class="center-align" style="margin-top: 18px;">
        <a href="/log-in" class="green-text text-darken-2">¿Ya tienes cuenta? Inicia sesión</a>
      </div>
    </div>
  </div>
</div>

    <br>
    <br>
    <%- include('../partials/footer') %>
</body>
</html>
