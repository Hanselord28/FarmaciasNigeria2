    <script>
      document.addEventListener('DOMContentLoaded', function() {
        var elems = document.querySelectorAll('.carousel');
        var instances = M.Carousel.init(elems, {
          fullWidth: true,
          indicators: true,
          duration: 200
        });
        setInterval(function() {
          var instance = M.Carousel.getInstance(elems[0]);
          instance.next();
        }, 5000);
      });
