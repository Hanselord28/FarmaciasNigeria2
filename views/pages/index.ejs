     <div class="carousel carousel-slider center">
  <!-- Item 1 -->
  <div
    class="carousel-item"
    style="background-image: url('ress/Banner1.jpeg'); background-size: cover; background-position: center;"
  ></div>

  <!-- Item 2 -->
  <div
