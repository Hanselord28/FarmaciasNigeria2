<!DOCTYPE html>
  <html>
    <%- include('../partials/head') %>
    <body>
      <!-- inicio navbar-->
       <%- include('../partials/header') %>
     <!--fin navbar-->
         <br><br>
         <div class="container" style="max-width: 410px; margin-top: 50px;">
  <div class="card z-depth-2 green lighten-5">
    <div class="card-content">
      <span class="card-title center-align green-text text-darken-2" style="font-weight: 600;">Iniciar Sesión</span>
      <form id="Log">
        <div class="input-field">
          <input type="email" id="Usuario" class="validate" required>
          <label for="Usuario">Correo Electrónico</label>
        </div>
        <div class="input-field">
          <input type="password" id="Contra" class="validate" required>
          <label for="Contra">Contraseña</label>
        </div>
        <div class="center-align" style="margin-top: 30px;">
          <button type="submit" class="btn green darken-1 waves-effect waves-light" style="width: 100%;">Ingresar</button>
        </div>
      </form>
      <div class="center-align" style="margin-top: 18px;">
        <a href="#" class="green-text text-darken-2">¿Olvidaste tu contraseña?</a>
        <a href="/registroUsuario" class="green-text text-darken-2" style="display: block; margin-top: 10px;">¿No tienes cuenta? Regístrate</a>
      </div>
    </div>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>
<script>
  document.addEventListener("DOMContentLoaded", function () {
    const loginForm = document.getElementById("Log");
    loginForm.addEventListener("submit", function (e) {
      e.preventDefault();
      const email = document.getElementById("Usuario").value;
      const password = document.getElementById("Contra").value;
      const usuarioCorrecto = "elPePe@Nigeria.com";
      const contraseñaCorrecta = "1111";
      if (email === usuarioCorrecto && password === contraseñaCorrecta) {
        alert("Inicio de sesión exitoso!");
        window.location.href = "FarmaciasNigeriaWeb.html";
      } else {
        alert("Correo o contraseña incorrectos.");
      }
    });
  });
</script>



    <%- include('../partials/footer') %>
    </body>
    
  </html>