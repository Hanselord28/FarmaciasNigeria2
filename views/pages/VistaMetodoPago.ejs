<html>
<%- include('../partials/headpago') %>
<body>
<%- include('../partials/header') %>
  <div class="container">
    <div id="paymentBrick_container">
  </div>
  <script>
(async function() {
  // 1. Pide el preferenceId al backend antes de renderizar el Brick
  const response = await fetch("/create_preference", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ amount: 10000 }) // Cambia aquí si el monto es variable
  });
  const data = await response.json();

  if (!data.preferenceId) {
    alert("Error al obtener preferenceId");
    return;
  }

  // 2. Inicializa MercadoPago y Bricks
  const mp = new MercadoPago('TEST-bc932d8e-a5af-40d0-a7b9-236ec4a2086b', { locale: 'es' });
  const bricksBuilder = mp.bricks();

  // 3. Renderiza el Brick con el preferenceId recibido
  await renderPaymentBrick(bricksBuilder, data.preferenceId);
})();

async function renderPaymentBrick(bricksBuilder, preferenceId) {
  const settings = {
    initialization: {
      amount: 10000, // El mismo monto que usaste en el backend
      preferenceId: preferenceId,
      payer: {
        firstName: "",
        lastName: "",
        email: "",
      },
    },
    customization: {
      visual: {
        style: {
          theme: "default",
        },
      },
      paymentMethods: {
        creditCard: "all",
        debitCard: "all",
        ticket: "all",
        atm: "all",
        onboarding_credits: "all",
        wallet_purchase: "all",
        maxInstallments: 1
      },
    },
    callbacks: {
      onReady: () => {
        // Puedes ocultar loaders aquí si tienes
      },
      onSubmit: ({ selectedPaymentMethod, formData }) => {
        // callback llamado al hacer clic en pagar
        return new Promise((resolve, reject) => {
          fetch("/process_payment", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify(formData),
          })
            .then((response) => response.json())
            .then((response) => {
              // Aquí puedes mostrar un mensaje de éxito
              if (response.error) {
                alert("Error al pagar: " + response.details);
                reject();
              } else {
                alert("Pago exitoso o enviado para procesar.");
                res.window.location.href = "/pagoexitoso"; // Redirige a una página de éxito
                resolve();
              }
            })
            .catch((error) => {
              alert("Error inesperado al procesar el pago.");
              reject();
            });
        });
      },
      onError: (error) => {
        // callback para manejar errores del Brick
        console.error(error);
        alert("Error en el pago: " + error.message || error);
      },
    },
  };

  window.paymentBrickController = await bricksBuilder.create(
    "payment",
    "paymentBrick_container",
    settings
  );
}
</script>

  </div>
<%- include('../partials/footer') %>
</body>
</html>
  








